<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الصلاحيات المطلوبة -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.CALL_PHONE" /> <!-- لطوارئ الاتصال -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Battery Detox"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- الشاشة الرئيسية -->
        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.LockScreenActivity"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"/> <!-- لكي لا يظهر في قائمة التطبيقات المفتوحة -->

        <!-- تسجيل المستمع لأحداث الشاحن -->
        <receiver android:name=".receiver.BatteryReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- تسجيل المستمع لإعادة تشغيل الهاتف -->
        <receiver android:name=".receiver.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- تسجيل خدمة المراقبة -->
        <service android:name=".service.BatteryMonitorService" 
            android:exported="false" 
            android:foregroundServiceType="specialUse" />
            <!-- خاصية specialUse مدعومة من أندرويد 14 فما فوق لتطبيقات الأدوات المخصصة -->

    </application>
</manifest>